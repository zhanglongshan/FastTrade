# 本地环境配置与密钥（禁止提交）
.env
.env.*
!.env.example
!front-web/.env.development.example
!front-web/.env.production.example
# 量化环境配置目录：整目录内容忽略（含 .env.dev / .env.prod 真实密钥），只保留可提交的模板
# 用 backend/env/* 而非 backend/env/，否则父目录被忽略后 ! 例外无法生效
backend/env/*
!backend/env/.env.example
!backend/env/.env.quant.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
backend/logs/

# 前端
node_modules/
dist/
*.local

# IDE 与系统文件
.idea/
.vscode/
.DS_Store

# 量化下载数据（策略代码仍然纳入版本管理）
user_data/data/**
!user_data/data/.gitkeep
!user_data/data/binance/
user_data/data/binance/*
!user_data/data/binance/.gitkeep
user_data/logs/

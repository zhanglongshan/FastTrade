# 【通用】环境变量 - 所有环境共享

# 项目名称
VITE_APP_TITLE = FastTrade

# 应用版本号
VITE_VERSION = 3.0.0

# 开发服务器端口
VITE_PORT = 5180

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /web

# 权限模式【 frontend 仅前端路由 / backend 仅后端菜单 / mixed 后端菜单+前端路由模块合并 】
VITE_ACCESS_MODE = mixed

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否在控制台输出路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

# 网络请求超时时间（毫秒）
VITE_API_TIMEOUT = 120000

# 代理前缀（浏览器侧请求前缀，经 Vite 代理转发到后端）
VITE_APP_BASE_API = /api/v1

# 代理目标：本机后端。vite.config.ts 的 server.proxy 使用此变量作为 target，
# 缺失会导致代理转发到 undefined，表现为登录页获取验证码接口返回 500。
VITE_API_BASE_URL = http://127.0.0.1:8001
